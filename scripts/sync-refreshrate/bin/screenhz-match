#!/usr/bin/env zsh
#
# $1    : emulated Hz (e.g. "59.94", "30.0", "47.95")
# $2    : vrr max refresh rate
# $3-N  : supported fix refresh rates.
# output: closest supported fixed rate, or VRR fallback
#
# Tuning knobs:
# MAX_DEVIATION_PP10k = max allowed relative deviation in parts-per-10,000
#   10   -> 0.0001% | very strict
#   100  -> 0.001%
#   1000 -> 0.01%   | generous, catches 59.94<->60.00 etc.
# HARMONICS = how many sub-multiples of each fixed rate to check

readonly MAX_DEVIATION_PP10k=500 # 0.005%
readonly SCALE=1000000
readonly HARMONICS=( 2 3 4 )

PATH=$( dirname `realpath $0` ):$PATH

requestedhz=$1
shift
vrrmax=${argv[1]}
shift

# Convert 59.94 -> 59940000, integer scaled by SCALE.
# Handles values with 0, 1, or many fractional digits.
decimal_to_scaled() {
  local raw=$1
  local int frac

  if [[ $raw == *.* ]]
  then
    int=${raw%.*}
    frac=${raw#*.}
  else
    int=$raw
    frac=""
  fi
  # Pad/truncate frac to match SCALE, e.g., 1000000 → 000000 or 6 zeros.
  zero_pad=$( printf '%0*d' $(( ${#SCALE} - 1 )) 0 )
  frac=${frac}$zero_pad       # pad with zero's
  frac=${frac:0:${#zero_pad}} # truncate
  # Force base-10 to avoid octal on leading zeros
  echo $(( 10#$int * SCALE + 10#$frac ))
}

scaledhz=$( decimal_to_scaled $requestedhz )
matchhz=-1
deviation=$MAX_DEVIATION_PP10k
vrrscaled=$( decimal_to_scaled $vrrmax )

for rate in $@
do
  srate=$( decimal_to_scaled $rate )
  (( srate == vrrscaled )) && continue

  # Check the fixed rate itself, then each harmonic ( rate / N ).
  candidates=( $srate )
  for n in $HARMONICS; candidates+=$(( srate / n ))

  for c in $candidates
  do
    diff=$(( scaledhz - c ))
    (( diff < 0 )) && diff=$(( -diff ))

    # Relative deviation in parts-per-10000
    pp=$(( diff * 10000 / c ))
    if (( pp < deviation ))
    then
      deviation=$pp
      matchhz=$srate
    fi
  done
done

if (( matchhz > 0 ))
then
  result=$matchhz
else
  result=$vrrscaled
fi
# Convert back to decimal for output
printf '%d.%06d\n' $(( result / SCALE )) $(( result % SCALE ))
