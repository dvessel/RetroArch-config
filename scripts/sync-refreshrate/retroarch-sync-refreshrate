#!/usr/bin/env zsh

zparseopts -D -F - -debug=zdebug || exit 1

PATH=$( dirname `realpath $0` )/bin:$PATH

if [[ $( raconfig --get config_save_minimal ) == true ]]
then
  print "Incompatible with 'config_save_minimal'." >&2
  exit 1
fi

log_dir=$( raconfig --get log_dir )
libretro_info_path=$( raconfig --get libretro_info_path )

# --debug printer
function dprint {
  if (( ${#zdebug} ))
  then
    local flag cn zl l=-
    zparseopts -D -F - l=zl {ok,no,c0,c1,c2,c3,c4,c5,c6,c7}=flag || return 1
    (( ${#zl} )) && l=' '
    cn=${${flag#-c}:-0}
    case ${flag[-1]} in
      -no) printf "✗ \e[0;31m%s\e[0m\n" $@ ;;
      -ok) printf "✓ \e[0;32m%s\e[0m\n" $@ ;;
        *) printf "$l \e[0;3${cn}m%s\e[0m\n" $@ ;;
    esac
  fi
}

# Set refresh rate to the closest matching fixed rate of the display.
function set_hz {
  rascreen --set-hz $1 &
  local pid=$!
  if kill -0 $pid 2>/dev/null
  then
    RASCREEN_PIDS+=$pid
  else
    print "Failed to set refreshrate." >&2
    return 1
  fi
}

# Release refresh rate changes to previous state.
# They will self-release when RetroArch quits but this function releases
# them when a core unloads.
function release_hz {
  local pid
  for pid in $RASCREEN_PIDS
  do
    if [[ $( ps -p $pid -o comm= 2>/dev/null ) == rascreen ]]
    then
      dprint "kill $pid: rascreen"
      kill -TERM $pid 2>/dev/null
      print "refresh rate released."
    fi
  done
  RASCREEN_PIDS=()
}

# Monitors for when RetroArch quits then cleans up.
function retroarch_exit_cleanup {
  while pgrep -x RetroArch &>/dev/null
  do
    sleep 2
  done
  dprint -ok "Stop: retroarch_exit_cleanup"
  # The log gets truncated when RetroArch launches, causing confusion with tail.
  # It misses a few lines and places the script in an unknown state. Move it
  # with a *-last.log suffix so it creates a new one on next launch. `tail -F`
  # will wait and resume as RetroArch creates a new log file.
  local log_dir=$( raconfig --get log_dir )
  if [[ -f $log_dir/retroarch.log ]]
  then
    mv -f $log_dir/retroarch.log $log_dir/retroarch-last.log
  fi
}

# Required logging options for the script to function.
raconfig --set frontend_log_level=1
raconfig --set log_to_file=true
raconfig --set log_to_file_timestamp=false
raconfig --set log_verbosity=true

# State variables
local loading=0 running=0 mswitch=0
# emuhz: refresh rate of emulated machine
# srate: sample rate of emulated machine
# arate: adjusted sample rate to match adjusted refresh rate.
local emuhz= srate= arate= content_path= core=
# pid of RetroArch exit monitor.
local retroarch_exit_cleanup_pid=
# running rascreen holding onto refresh rate changes.
typeset -a RASCREEN_PIDS=()
# Cache core name lookups to avoid repeated sed invocations.
typeset -A core_cache=()
# Search strings for AV changes.
typeset -a av_search=(
  '([0-9]+x[0-9]+)'
  'Aspect: ([0-9]\.[0-9]+)'
  'FPS: ([0-9]+\.[0-9]+)'
  'Sample rate: ([0-9]+(\.[0-9]+)?)'
)

# Clean up before exiting the script.
trap '
  print -u2 "Cleaning up."
  pkill -P $$ -f "tail .*retroarch.log" 2>/dev/null
  if kill -0 $retroarch_exit_cleanup_pid 2>/dev/null
  then
    kill -TERM $retroarch_exit_cleanup_pid 2>/dev/null
  fi
  release_hz
  exit
' HUP INT TERM

# Log parsing loop:
# - content loading
# - core loading                  -> set loading context.
#   - get refresh rate
#   - start synchronous audio     -> set running context.
#     - set refresh rate!
#     - get refresh rate          1. running context loop.
#     - start synchronous audio   2. running context loop.
#       - set refresh rate!       3. running context loop.
# - unloading core or quit        -> reset context.
#   - release refresh rates!
while IFS= read -r line < <( tail -Fn-1 $log_dir/retroarch.log )
do
   # Skip lines not prefixed with the following (speedup):
  if [[ ! $line =~ '^\[INFO\] \[(Core|Audio|Video|Environ|NS)\].*' ]]
  then
    continue
  fi

  # Content Loading:
  # - When run from the menu system, loads as "[INFO] [Core] Using content:"
  # - When run from the cli, loads as "[INFO] [Content] Loading content file:"
  #   if it does at all. It depends on the media type.
  # - Some cores will log both forms when run from the menu.
  if [[ $line =~ '\[Core\] Using content: "(.+)"' ]]
  then
    dprint -ok "Content Loading"
    content_path=${match[1]}
    print "loading: ${content_path/#$HOME/~}"

  # Core Loading:
  elif [[ $line =~ '\[Core\] Loading dynamic libretro core from: ".+\/(.+)\.dylib"' ]]
  then
    local core_key=${match[1]}
    core=${core_cache[$core_key]:-}
    if [[ -z $core ]]
    then
      core=${$(
        sed -En 's/^corename = "(.+)"/\1/p' $libretro_info_path/$core_key.info 2>/dev/null
      ):-${core_key%_libretro}}
      core_cache[$core_key]=$core
    fi
    dprint -ok "Core Loading: $core"
    loading=1
    running=0
    mswitch=0
    RASCREEN_PIDS=()
  fi

  # Loading Context:
  if (( loading ))
  then
    # Get Refresh Rate:
    if [[ $line =~ "\[Core\] Geometry: ${(j:, :)av_search}" ]]
    then
      dprint "AV Information"
      dprint -l dimensions:${match[1]} aspect-ratio:${match[2]} \
                refresh-rate:${match[3]}Hz sample-rate:${match[4]}Hz
      emuhz=${match[3]}
      srate=${match[4]}

    elif [[ $line =~ '\[Audio\] Set audio input rate to: ([0-9]+\.[0-9]+)' ]]
    then
      arate=${match[1]}
      printf 'Dynamic Rate Control: sample rate %sHz->%sHz, deviation %+.4f%%.\n' \
        $srate $arate $(( (arate - srate) / srate * 100 ))

    # Warning! `video_refresh_rate` is not properly set.
    elif [[ $line =~ '\[Video\] Timings deviate too much.+= ([0-9]+\.[0-9]+).+ = ([0-9]+\.[0-9]+)' ]]
    then
      printf 'Dynamic Rate Control: requested rate (%sHz) deviates too far from setting (%sHz).\n' \
        ${match[2]} ${match[1]}

    # Set Refresh Rate:
    # When the audio driver starts, emulation starts.
    elif [[ $line =~ '\[Audio\] (Start.+ audio) driver' ]]
    then
      dprint -ok "${match[1]} - Emulation Started"
      set_hz $emuhz
      loading=0
      running=1
      mswitch=0
    fi

  # Running Context:
  elif (( running ))
  then
    # Get Refresh Rate:
    # Mid-run refresh rate changes. Mainly applies to MAME emulation.
    if [[ $line =~ "\[Environ\] SET_SYSTEM_AV_INFO: ${(j:, :)av_search}" ]]
    then
      if [[ ${match[3]} != $emuhz ]]
      then
        dprint -c3 "AV Information - Update"
        dprint -l dimensions:${match[1]} aspect-ratio:${match[2]} \
                  refresh-rate:${match[3]}Hz sample-rate:${match[4]}Hz
        emuhz=${match[3]}
        srate=${match[4]}
        mswitch=1
      fi

    # Unload & Reset...
    elif [[ $line =~ '(\[Core\] Unloading core|\[NS\] stopping draw observer)' ]]
    then
      dprint -ok "Unloading Core: $core"
      release_hz
      loading=0
      running=0
      mswitch=0

    # Mid-run Refresh Rate Switch Context:
    elif (( mswitch ))
    then
      if [[ $line =~ '\[Audio\] Set audio input rate to: ([0-9]+\.[0-9]+)' ]]
      then
        arate=${match[1]}
        printf 'Dynamic Rate Control: sample rate %sHz->%sHz, deviation %+.4f%%.\n' \
          $srate $arate $(( (arate - srate) / srate * 100 ))

      # Warning! `video_refresh_rate` is not properly set or the core has not settled
      # to the correct refresh rate. This can happen with some systems in MAME, e.g.,
      # sega/stv.cpp->cotton2 switches refresh rates multiple times while booting.
      elif [[ $line =~ '\[Video\] Timings deviate too much.+= ([0-9]+\.[0-9]+).+ = ([0-9]+\.[0-9]+)' ]]
      then
        printf 'Dynamic Rate Control: requested rate (%sHz) deviates too far from setting (%sHz).\n' \
          ${match[2]} ${match[1]}

      # Set Refresh Rate:
      elif [[ $line =~ '\[Audio\] (Start.+ audio) driver' ]]
      then
        dprint -ok "Switch Refresh Rate"
        set_hz $emuhz
        mswitch=0
      fi
    fi
  fi

  # Singleton to detect when RetroArch has exited.
  # retroarch_exit_cleanup_pid is pre-initialized to "" so the trap is always safe.
  # kill -0 returns non-zero when the process has exited or the PID is unset. When
  # RetroArch relaunches, retroarch_exit_cleanup will have exited, so this re-spawns it.
  if ! kill -0 $retroarch_exit_cleanup_pid 2>/dev/null
  then
    dprint -ok "Start: retroarch_exit_cleanup"
    retroarch_exit_cleanup &
    retroarch_exit_cleanup_pid=$!
  fi
done
