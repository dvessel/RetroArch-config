#!/usr/bin/env zsh
# TODO: use new structure for speed ups post mameinfo update.

PATH=$( dirname `realpath $0` ):$PATH

for rom in $1/*.(zip|7z)(N)
do
	if [[ -L $rom ]]
	then
		# ignore symlinks.
		continue
	fi
	read -d '' isbios isdevice driver_status description < <(
		mameinfo -r '.isbios,.isdevice,.driver.status,.description' $rom
	)
	echo $description

	case "yes" in
		($isbios) tag -a "BIOS" $rom ;;
		($isdevice) tag -a "Device" $rom ;;
	esac
	case $driver_status in
		(preliminary) tag -a "Preliminary" $rom ;;
	esac

	for item in $rom $rom:r
	do
		test -e $item || continue
		comment=$(
			xattr -xp com.apple.metadata:kMDItemFinderComment $item 2>/dev/null | xxd -r -p | plutil -p - 2> /dev/null
		)
		if [[ $comment != $description ]]
		then
		  osargs=(
				-e 'on run {f, d}'
				-e 'tell app "Finder" to set comment of (POSIX file f as alias) to d'
				-e 'end'
				"file:///$item:a" "$description"
			)
			osascript $osargs &> /dev/null
		fi
	done
done
