#!/usr/bin/env zsh

PATH=${0:A:h}:$PATH

zparseopts -D -F -E - \
  {z,-mamezip}:=zmamezip \
  {s,-samples}:=zsamples \
  {x,-appendxml}:=zappendxml || return 1

all_commands=(
  init
  scan scan-verbose
  repair repair-preview
  cleanup cleanup-preview
)
command=${all_commands:*argv}
if [[ -n $1 && $command == $1 ]]
then shift
else
  echo "Available commands: ${(j/, /)all_commands}" >&2
  return 1
fi

scandir=${${1:a}:-$PWD}
if [[ $scandir == $1:a ]]
then shift
fi
if [[ ! -d $scandir ]]
then
  echo "Not a valid scan directory: $scandir" >&2
  return 1
fi

appendxml=${${zappendxml[-1]:a}:-$XDG_DATA_HOME/advscan/mamexml/_append}
mamezip=${${zmamezip[-1]:a}:-$XDG_DATA_HOME/advscan/mamezip}
samples=${zsamples[-1]:a}

if mkdir -p $scandir/.advscan
then cd $scandir/.advscan
else return 1
fi

if [[ $command == init || ! -f advscan.rc ]]
then
  echo "Initializing..."

cat <<-EOF > advscan.rc
# generated by $0:t
# https://www.advancemame.it/doc-advscan

# List of paths where the roms are placed. These are the zip archives, which are
# modified and fixed.
rom roms:roms-new

# Single directory where the new created zip archives are placed. It's STRONGLY
# suggested to put this path ALSO in the 'rom' specification. Otherwise at the
# next run the zip archives are recreated.
rom_new roms-new

# List of directory trees where other roms files are placed. These are used for
# importing rom file missing in rompath. These files are only read and never
# modified in any way. It's very useful to insert here any rom directories of
# any other arcade emulators. When a new game will be supported the rom archive
# will be made automatically.
rom_import mamezip

# List of paths where the chd archives are placed. Subfolders will be added
# automatically before each scan. advscan can only validate disk checksums.
disk roms

# List of paths where the samples are placed. These are the zip archives, which
# are modified and fixed.
sample samples

# Single directory where unknown rom zip archives will be moved. In this directory
# is inserted any rom file removed from the rom zip archives. However, any rom
# file is automatically deleted by advscan if it's duplicated in an archive listed
# on the 'rom' or 'rom_import' options.
rom_unknown mamezip/unknown/roms

# Single path where unknown disk chd archives will be moved.
disk_unknown mamezip/unknown/disks

# Single path where unknown sample zip archives will be moved. In this directory
# is inserted any sample file removed from the sample zip archives.
sample_unknown mamezip/unknown/samples

EOF

  if [[ $command == init ]]
  then find . -type l -delete
  fi

  mkdir -p roms-new samples mamexml mamezip/unknown/{roms,disks,samples}

  ln -sF .. roms
  if [[ -d $mamezip ]]
  then ln -s $mamezip/* mamezip
  fi
  if [[ -d $appendxml ]]
  then ln -s $appendxml mamexml/_append
  fi
  if [[ -d $samples ]]
  then ln -sF $samples samples
  fi

fi

mamexml=mamexml/current.xml
version=${mamexml:A:t:r}

if [[ ! -e $mamexml || $scandir -nt $mamexml ]]
then
  # Remove decimals and truncate. MAME version 0.250.0.1 results in 0250.
  version=$( mame -version | awk -F'[ .]' '{print $1$2}' )
  if [[ -z $version ]]
  then version=unknown
  fi
  echo "Building xml file... v.$version"
  mamexml-generate $scandir mamexml/$version.xml
  ln -sf $version.xml $mamexml
fi

# Add disk sub-directories to the advscan.rc file so it can be seen.
chdir=( roms/*/(N) )
sed -i '' -E "s|^(disk ).*|\1${(j[:])chdir:-roms}|" advscan.rc

mkdir -p reports
report_file=$( date "+%y%m%d%H%M%S" )-v${version}-${command}.txt

# Modes:
#   -r, --rom          Operate on rom sets
#   -s, --sample       Operate on sample sets
#   -k, --disk         Operate on disk files
# Operations:
#   -a, --add-zip      Add missing zips
#   -b, --add-bin      Add missing files in zips
#   -d, --del-zip      Delete unknown zips
#   -u, --del-unknown  Delete unknown files in zips
#   -g, --del-garbage  Delete garbage files
#   -t, --del-text     Delete unused text files
# Shortcuts:
#   -R, --rom-std      Shortcut for -rabdug
#   -S, --sample-std   Shortcut for -sabdug
# Commands:
#   -e, --equal        Print list of roms with equal crc+size
#   -i, --ident FILE   Identify roms by crc and size
#   -b, --bbs          Output a 'files.bbs' for roms .zip
#   -h, --help         Help of the program
#   -V, --version      Version of the program
# Options:
#   -c, --cfg FILE     Select a configuration file
#   -f, --filter FILT  Filter the game list
#   -p, --report       Write a rom based report
#   -P, --report-zip   Write a zip based report
#   -n, --print-only   Only print operations, do nothing
#   -v, --verbose      Verbose output

case $command in
  init)
    exit
    ;;
  scan)
    echo "Scanning... v.$version"
    advscan -rsk -Pv < $mamexml
    ;;
  scan-verbose)
    echo "Scanning... (verbose) v.$version"
    advscan -rsk -pv < $mamexml
    ;;
  repair)
    echo "Repairing... v.$version"
    advscan -rsk -bugt -v < $mamexml
    ;;
  repair-preview)
    echo "Repairing... (preview) v.$version"
    advscan -rsk -bugt -v --print-only < $mamexml
    ;;
  cleanup)
    echo "Cleanup... v.$version"
    advscan -rsk -dugt < $mamexml
    ;;
  cleanup-preview)
    echo "Cleanup... (preview) v.$version"
    advscan -rsk -dugt --print-only < $mamexml
    ;;
esac 2> >( sed -l '/Missing.*sampleof/d' >&2 ) | tee reports/$report_file | () {
  # Test if stdout is a terminal and colorize the output. If not, pass through with cat.
  if [[ -t 1 ]]
  # nodump bad/miss : yellow
  # rom miss/bad    : red
  # various others  : gray
  then perl -pe '/^([a-z]+_)?(good|bad|miss|text|binary|garbage)/; print (
        ( $1 eq nodump_ and ( $2 eq bad or $2 eq miss ) ) ? "\033[0;33m" :
        ( $1 eq rom_ and ( $2 eq miss or $2 eq bad ) )    ? "\033[0;31m" :
        ( $2 eq text or $2 eq binary or $2 eq garbage )   ? "\033[0;37m" : "\033[0m" )'
  else cat
  fi
}

# Remove empty reports file.
if [[ $( wc -l < reports/$report_file ) -le 1 ]]
then rm reports/$report_file
else printf 'generated report:\n%s\n' $scandir/.advscan/reports/$report_file
fi
