#!/usr/bin/env zsh
#
# MAME config overrides:
# - Save state related settings disabled when a machine doesn't support it.
# - TATE mode sets `video_scale_integer_axis` to X.
#
PATH=${0:A:h}:$PATH

if ! mameinfo --init-path $1
then
  echo "Failed to initialize." >&2
  exit 1
fi
if [[ $( raconfig --get config_save_minimal ) == true ]]
then
  echo "Incompatible with 'config_save_minimal'." >&2
  exit 1
fi

scandir=$1
cfgdir=$( raconfig --get rgui_config_directory )/MAME

typeset -A savestate_related_supported savestate_related_unsupported
# Prefixed `-keys` to disable only. Will not be restored to defaults.
for skey in menu_show_latency \
            menu_show_rewind \
           -preemptive_frames_enable \
            quick_menu_show_replay \
            quick_menu_show_save_load_state \
            quick_menu_show_savestate_submenu \
            quick_menu_show_undo_save_load_state \
           -rewind_enable \
           -run_ahead_enabled \
            savestate_auto_load \
            savestate_auto_save
do
  # To be used to reset when it's supported.
  if [[ $skey[1] != - ]]
  then savestate_related_supported+=( ${skey#-} $( raconfig --get ${skey#-} $cfgdir/MAME.cfg ))
  fi
  # And disabled when it's not.
  savestate_related_unsupported+=( ${skey#-} false )
done

# TATE Integer Axis: X, Integer Scaling: Smart Scale
tate_vsia=4 tate_vsis=2
typeset -A tate_video_scale=(
  video_scale_integer_axis    $tate_vsia
  video_scale_integer_scaling $tate_vsis
)
typeset -A map_vsia=(
  0 'Scale Integer Axis Y'
  1 'Scale Integer Axis Y+X'
  2 'Scale Integer Axis Y+X.5'
  3 'Scale Integer Axis Y.5+X.5'
  4 'Scale Integer Axis X'
  5 'Scale Integer Axis X.5'
)
typeset -A map_vsis=(
  0 'Underscale'
  1 'Overscale'
  2 'Smart Scale'
)
typeset -A process

while read -r line
do
  while read -r key value
  do typeset $key=$value
  done < <( jq -r 'to_entries[] | "\(.key) \(.value)"' <<< $line )

  scpp=-${${sourcefile:r}//\//-}
  if [[ $rotate == (90|270) ]]
  then scpp+=\~tate
  fi

  if ! (( $process[$scpp] ))
  then process[$scpp]=1
  else continue
  fi

  # Runs asynchronously.
  () {
    trap 'exit' INT # hault on ctrl-c
    changes=0
    keyvalues=savestate_related_${savestate}
    for key value (${(Pkv)keyvalues}) if [[ $( raconfig --get $key $@ ) != $value ]]
    then
      raconfig --override $key=$value $@
      changes=1
    fi
    if (( changes ))
    then
      sort -o $1 $1
      printf '%s: Save State %s. Related settings were updated.\n' ${1:t} $savestate
    fi

    if [[ $rotate == (90|270) ]]
    then
      changes=0
      for key value (${(kv)tate_video_scale}) if [[ $( raconfig --get $key $@ ) != $value ]]
      then
        raconfig --override $key=$value $@
        changes=1
      fi
      if (( changes ))
      then
        sort -o $1 $1
        printf '%s: %s, %s\n' ${1:t} ${map_vsia[$tate_vsia]} ${map_vsis[$tate_vsis]}
      fi
    fi
  } $cfgdir/$scpp.cfg $cfgdir/MAME.cfg &

done < <( mameinfo -cr 'select( .isbios != "yes" and .isdevice != "yes" ) |
        { sourcefile:.sourcefile,
          savestate:.driver.savestate,
          rotate:.display[0].rotate }' $scandir/*.(7z|zip) )

# Wait for background jobs to complete.
wait
