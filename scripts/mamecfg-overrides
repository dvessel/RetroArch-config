#!/usr/bin/env zsh

PATH=$( dirname `realpath $0` ):$PATH

if [[ $( raconfig --get config_save_minimal ) == true ]]
then
  echo "Incompatible with 'config_save_minimal'." >&2
  return 1
fi

local scandir=~/Games/Emulation/Arcade
cdir=$( raconfig --get rgui_config_directory )/MAME

if ! mameinfo --init-path $scandir
then
  echo "Failed to initialize." >&2
  return 1
fi

settings_keys=(
  menu_show_latency
  menu_show_rewind
  quick_menu_show_replay
  quick_menu_show_save_load_state
  quick_menu_show_savestate_submenu
  quick_menu_show_undo_save_load_state
  savestate_auto_load
  savestate_auto_save
)
# Disabled save state related settings.
typeset -a savestate_related_unsupported
for key in $settings_keys preemptive_frames_enable run_ahead_enabled
do
  savestate_related_unsupported+="$key = false"
done
# Re-enable when it's supported.
typeset -a savestate_related_supported
for key in $settings_keys
do
  savestate_related_supported+="$key = $(raconfig --get $key $cdir/MAME.cfg)"
done

for source_dir in $scandir/.sorted/-*
do
  typeset -A vrr_runloop=()

  for rom in $source_dir/*.zip
  do
    if ! mameinfo --exists $rom
    then
      print "unrecognized '$rom'" >&2
      continue
    fi

    read -d '' isbios isdevice savestate refresh < <(
      mameinfo -r '.isbios,.isdevice,.driver.savestate,.display[0].refresh' -g $rom
    )
    case yes in
      # skip bios and devices.
      $isbios|$isdevice) continue ;;
    esac

    name=$rom:t:r
    # vrr 120hz cannot handle > 60hz gracefully when vrr_runloop_enable is true.
    # vrr run loop must be disabled.
    if (( $refresh <= 60.000000 ))
    then
      vrr_runloop[$name]=true
    else
      vrr_runloop[$name]=false
    fi
  done

  if (( ${#vrr_runloop} < 1 ))
  then
    continue
  fi

  source=${source_dir:t}

  typeset -au oob=( ${(u)vrr_runloop} )
  if [[ $oob == (true|false) ]]
  then
    raconfig --override vrr_runloop_enable=$oob $cdir/$source.cfg $cdir/MAME.cfg
    printf "%s: %s = %s\n" $source vrr_runloop_enable $oob
  else
    # mixed set
    for name value in ${(kv)vrr_runloop}
    do
      raconfig --override vrr_runloop_enable=$value $cdir/$name.cfg $cdir/$source.cfg $cdir/MAME.cfg
      printf " %s: %s = %s\n" $name vrr_runloop_enable $value
    done
  fi

  keyvalues="savestate_related_${savestate}"
  for kv in ${(P)keyvalues}
  do
    raconfig --override $kv $cdir/$source.cfg $cdir/MAME.cfg
    if [[ $savestate == unsupported ]]
    then
      printf "%s: %s\n" $source $kv
    fi
  done

done
