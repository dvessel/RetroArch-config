#!/usr/bin/env zsh
#
# Hardlinks MAME roms to the .sorted directory based on `mame -sourcelist`
# This enables directory based cfg overrides, core options and controller
# remapping. A set of games for a given source are likely to share settings.
#

if ! type mame &>/dev/null
then
  echo "mame required" >&2
  return 1
fi

local scandir=~/Games/Emulation/Arcade

if [[ ! -d $scandir/.sorted ]]
then
  mkdir $scandir/.sorted
  # exclude from time machine backups.
  tmutil addexclusion $scandir/.sorted
fi

rm -rf $scandir/.sorted/*(N)

typeset -aU names=(
  $scandir/*.zip(N:t:r)
)
typeset -A missing=(
  akatana cave/cv1k.cpp
  ddpsdoj cave/cv1k.cpp
)

if (( ${#names} ))
then
  sources=( ${(f)"$( mame -listsource $names 2>/dev/null )"} )
  for key in ${(k)missing}; [[ -n ${names[(r)$key]} ]] && {
    sources+="$key $missing[$key]"
  }
  # normalize spacing and sort by the second field.
  for listsource in ${(f)"$( printf '%s\n' ${sources[@]} | awk '{$1=$1};1' | sort -k2 )"}
  do
    set -- ${(s: :)listsource}

    name=$1
    scpp=-${${2:r}/\//-}
    sdir=$scandir/.sorted/$scpp

    # optional tags to ignore.
    if  type tag &>/dev/null &&
        tag -Nlg $scandir/$name.zip | grep -Eq "^(Ignore|Device|BIOS)$"
    then
      continue
    fi

    test -d $sdir || mkdir -p $sdir
    ln $scandir/$name.zip $sdir/$name.zip

    # highlight the containing folder.
    printf "\e[0;34m%s\e[0;37m/\e[0m%s\n" $scpp $name.zip
  done
fi
